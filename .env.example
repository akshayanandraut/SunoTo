# Public frontend configuration
VITE_API_BASE_URL=http://127.0.0.1:8787/api/v1
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-anon-key
# Grasany OIDC is disabled/unregistered for SunoTo in central packet v2
# (central source 8d6f18a9000eb736a11ecc789a097cab7bc0f7d9). Keep unset until
# the registry provisions the exact client/callback and live acceptance passes.
# GRASANY_OIDC_ISSUER=
# GRASANY_OIDC_CLIENT_ID=
# GRASANY_OIDC_REDIRECT_URI=
# GRASANY_OIDC_TOKEN_ENCRYPTION_KEY= (base64url-encoded 32-byte AES-GCM key; secret store only)
# GRASANY_NOTIFY_SUNOTO_KEY= (unprovisioned; Worker secret store only)

# Store Worker secrets with `wrangler secret put`, never in this file.
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-server-side-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-store
RAZORPAY_KEY_ID=replace-in-secret-store
RAZORPAY_KEY_SECRET=replace-in-secret-store
RAZORPAY_WEBHOOK_SECRET=replace-in-secret-store
ANON_SESSION_SECRET=replace-with-at-least-32-random-bytes-in-secret-store
# No ADMIN_USER_ID/email allowlist is accepted. Central admin namespace is
# currently unprovisioned; admin APIs fail closed until signed claim policy exists.
ALLOWED_ORIGIN=http://127.0.0.1:5173
GRIEVANCE_OFFICER_NAME=replace-before-production
GRIEVANCE_EMAIL=replace-before-production

# Release evidence. These make the production validator fail closed; they are not secrets.
SMTP_VERIFIED_AT=replace-with-iso-timestamp-after-delivery-tests
LEGAL_APPROVAL_REFERENCE=replace-with-counsel-approval-reference
RELEASE_REVISION=replace-with-40-character-release-commit
CLOUDFLARE_PAGES_PROJECT=replace-with-pages-project-name
PAGES_BRANCH=replace-with-deployment-branch
